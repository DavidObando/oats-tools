#!/bin/sh
# todo-scan — scan the repository in the current directory (or a path
# given as arg 1) for TODO, FIXME, and HACK comments, excluding .git.
# Prints each hit as file:line: text, followed by a count summary per
# marker.
# Usage: todo-scan [path]
set -eu

root="${1:-.}"
cd "$root"

matches=$(find . -type f -not -path './.git/*' \
  -exec grep -nHE '\b(TODO|FIXME|HACK)\b' {} + 2>/dev/null || true)

if [ -n "$matches" ]; then
  printf '%s\n' "$matches"
fi

echo
echo "== summary =="
for marker in TODO FIXME HACK; do
  count=$(printf '%s\n' "$matches" | grep -cE "\\b${marker}\\b" || true)
  echo "$marker: $count"
done
